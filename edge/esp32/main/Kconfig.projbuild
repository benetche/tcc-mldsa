menu "IoMT ESP32 (TCC)"

    choice IOMT_SCENARIO
        prompt "Cenário experimental"
        default IOMT_SCENARIO_C3
        help
            C3 = baseline ECDSA (esp32_direct).
            C4 = ML-DSA (tentativa on-device; fallback documentado se falhar).

        config IOMT_SCENARIO_C3
            bool "C3 — baseline ECDSA-P256"
        config IOMT_SCENARIO_C4
            bool "C4 — ML-DSA-65 (experimental)"
    endchoice

    config IOMT_DEVICE_ID
        string "Device ID IoMT"
        default "esp32-ward-01"
        help
            Usado em tópicos MQTT e observações on-chain.

    config IOMT_WIFI_SSID
        string "WiFi SSID"
        default "iomt-lab"

    config IOMT_WIFI_PASSWORD
        string "WiFi password"
        default ""
        help
            Preferir secrets.h (gitignored) em produção de laboratório.

    config IOMT_MQTT_BROKER_URI
        string "MQTT broker URI"
        default "mqtt://192.168.0.10:1883"
        help
            Broker Mosquitto do stack monitoring/ (host de laboratório).

    choice IOMT_PUBLISH_PRESET
        prompt "Preset de intervalo (paridade hospital-low/high no ESP)"
        default IOMT_PUBLISH_PRESET_LOW
        help
            hospital-low no YAML usa 500ms no Pi; no ESP32 o gargalo é assinatura (~150ms).
            high usa ~1s no ESP (stress sem saturar CPU).

        config IOMT_PUBLISH_PRESET_LOW
            bool "hospital-low (~5s)"
        config IOMT_PUBLISH_PRESET_HIGH
            bool "hospital-high (~1s)"
    endchoice

    config IOMT_PUBLISH_INTERVAL_MS
        int "Intervalo entre publicações (ms)"
        default 5000 if IOMT_PUBLISH_PRESET_LOW
        default 1000 if IOMT_PUBLISH_PRESET_HIGH
        range 500 60000

    config IOMT_SIGNING_MODE
        string "signing_mode (metadata)"
        default "esp32_direct" if IOMT_SCENARIO_C3
        default "esp32_payload_only" if IOMT_SCENARIO_C4
        help
            C3: assinatura ECDSA on-device. C4: stub ML-DSA → payload_only + relay MQTT.

endmenu
