# Copiar para config.env e ajustar caminhos (não versionar config.env)
# Credenciais de laboratório — User1@org1.example.com do test-network

export FABRIC_MSP_ID=Org1MSP
export FABRIC_CHANNEL=iomtchannel
export FABRIC_CHAINCODE=iomt
export FABRIC_PEER_ENDPOINT=localhost:7051

# Host de desenvolvimento (ajustar IP do PC se Pi estiver na rede)
# export FABRIC_PEER_ENDPOINT=192.168.0.10:7051

export FABRIC_TLS_CERT_PATH=/caminho/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
export FABRIC_CERT_PATH=/caminho/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/cert.pem
# Nome do arquivo em keystore/ varia (ex.: 77899319..._sk) — use scripts/export-fabric-env.sh
export FABRIC_KEY_PATH=/caminho/.../keystore/<hash>_sk

export IOMT_DEVICE_ID=pi-lab-001
