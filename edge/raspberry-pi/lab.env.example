# Copiar para lab.env — NÃO versionar lab.env (contém senha)
# cp lab.env.example lab.env

# SSH — Raspberry Pi 4
PI_HOST=192.168.0.100
PI_USER=pi
PI_SSH_PASSWORD=          # ou deixe vazio e use chave SSH
PI_REMOTE_SUBDIR=tcc-iomt

# Deixe vazio para auto-detectar no deploy (IP do PC: hostname -I)
LAB_FABRIC_HOST=

# Fabric
FABRIC_CHANNEL=iomtchannel
FABRIC_CHAINCODE=iomt
IOMT_DEVICE_ID=pi-lab-001

# Cenário do deploy/smoke: baseline (C1) ou mldsa (C2)
FABRIC_NETWORK=mldsa

# 1 = compila liboqs no Pi na 1ª vez (C2); 0 = pula se já instalado
# PI_BUILD_MLDSA_ON_DEVICE=1

# Versão dos binários peer (ARM64) instalados no Pi se ausentes
FABRIC_VERSION=2.5.12
